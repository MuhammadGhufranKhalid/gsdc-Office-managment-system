NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gsdc_oms
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Platform Super Admin (created by `npm run migrate`) ---
# Change the password before deploying.
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=superadmin@oms.com
SUPER_ADMIN_PASSWORD=Super@123

# --- Legacy tenant that adopts pre-existing records during migration ---
LEGACY_COMPANY_NAME=Ghufran Software Development Company
LEGACY_COMPANY_EMAIL=admin@gsdc.com
LEGACY_OWNER_NAME=Muhammad Ghufran
